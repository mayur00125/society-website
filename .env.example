# Server
PORT=3000
# Use a long random secret in production (e.g. openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-secret

# Optional SMTP for password-reset emails.
# If these are NOT set, forgot-password shows the reset link on screen
# and the admin can see pending reset links in the Admin > Reset Requests tab.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Society <noreply@example.com>
